# Optional environment overrides for codex-llama-server.service.
# Copy to /etc/default/codex-llama-server and edit as needed.

# Absolute path to the codex binary.
CODEX_BIN=/usr/local/bin/codex

# Optional working directory for the service (default is "/").
CODEX_WORKING_DIR=/

# remote-control command is fixed for this service.

# Optional profile and Ilhae config overrides for the running context.
# ILHAE_CONFIG_DIR=
# ILHAE_DATA_DIR=
