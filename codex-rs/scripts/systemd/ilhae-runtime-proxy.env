# Production service installs accept both local and remote clients. Use the
# host firewall to narrow exposure when this port should not be Internet-facing.
ILHAE_RUNTIME_PROXY_LISTEN=0.0.0.0:8083

# The installer replaces this marker with a persistent random token.
ILHAE_RUNTIME_PROXY_TOKEN=@ILHAE_RUNTIME_PROXY_TOKEN@

# Optional. Keep loopback-only upstream validation unless this runtime host
# intentionally needs to control an HTTP(S) server on another host.
# ILHAE_RUNTIME_PROXY_ALLOW_NON_LOOPBACK_UPSTREAM=1

RUST_LOG=codex_ilhae=info
