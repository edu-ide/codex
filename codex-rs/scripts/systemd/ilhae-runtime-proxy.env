# Bind to loopback and reach it through an SSH tunnel by default.
ILHAE_RUNTIME_PROXY_LISTEN=127.0.0.1:8083

# Optional on loopback. Required when ILHAE_RUNTIME_PROXY_LISTEN is non-loopback.
# ILHAE_RUNTIME_PROXY_TOKEN=replace-with-a-long-random-token

# Optional. Keep loopback-only upstream validation unless this runtime host
# intentionally needs to control an HTTP(S) server on another host.
# ILHAE_RUNTIME_PROXY_ALLOW_NON_LOOPBACK_UPSTREAM=1

RUST_LOG=codex_ilhae=info
