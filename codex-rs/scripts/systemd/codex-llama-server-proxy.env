# Environment overrides for codex-llama-server-proxy service.
# Copy to /etc/default/codex-llama-server-proxy and edit as needed.

# Rendered file and envsubst variable set used by the install script and service.
LLAMA_PROXY_ENV_VARS='${LLAMA_UPSTREAM_HOST} ${LLAMA_UPSTREAM_PORT} ${LLAMA_PROXY_LISTEN_ADDR} ${LLAMA_PROXY_LISTEN_PORT} ${LLAMA_PROXY_KEEPALIVE_TIMEOUT} ${LLAMA_PROXY_KEEPALIVE_REQUESTS} ${LLAMA_PROXY_READ_TIMEOUT} ${LLAMA_PROXY_CLIENT_MAX_BODY_SIZE} ${LLAMA_PROXY_CORS_ORIGINS} ${LLAMA_PROXY_RUNTIME_USER}'

# Paths used by the service unit.
LLAMA_PROXY_CONF_TEMPLATE=/etc/codex/codex-llama-server-proxy.conf.template
LLAMA_PROXY_CONF_FILE=/etc/codex/codex-llama-server-proxy.conf

# Upstream llama-server endpoint (local-only).
LLAMA_UPSTREAM_HOST=127.0.0.1
LLAMA_UPSTREAM_PORT=8082

# Publicly exposed address for the proxy (keep port separated from upstream).
LLAMA_PROXY_LISTEN_ADDR=0.0.0.0
LLAMA_PROXY_LISTEN_PORT=8083

# Runtime user used by nginx config.
LLAMA_PROXY_RUNTIME_USER=www-data

# Proxy tuning.
LLAMA_PROXY_KEEPALIVE_TIMEOUT=60
LLAMA_PROXY_KEEPALIVE_REQUESTS=1000
LLAMA_PROXY_READ_TIMEOUT=120
LLAMA_PROXY_CLIENT_MAX_BODY_SIZE=16m

# Optional CORS policy.
LLAMA_PROXY_CORS_ORIGINS="*"
