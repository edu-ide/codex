[Unit]
Description=Ilhae native runtime control proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@ILHAE_RUNTIME_PROXY_USER@
Group=@ILHAE_RUNTIME_PROXY_GROUP@
Environment=HOME=@ILHAE_RUNTIME_PROXY_HOME@
Environment=ILHAE_CONFIG_DIR=@ILHAE_RUNTIME_PROXY_HOME@/.ilhae
Environment=ILHAE_DATA_DIR=@ILHAE_RUNTIME_PROXY_HOME@/.ilhae
EnvironmentFile=-/etc/default/ilhae-runtime-proxy
ExecStart=@ILHAE_RUNTIME_PROXY_BINARY@
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
UMask=0077
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
WorkingDirectory=@ILHAE_RUNTIME_PROXY_HOME@

[Install]
WantedBy=multi-user.target
